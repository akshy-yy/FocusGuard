{
  "manifest_version": 3,
  "name": "FocusGuard",
  "description": "Website blocker for focused work",
  "version": "1.0",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    
    "default_icon":{
      "16": "assets/img16.png",
      "48": "assets/img48.png",
      "128": "assets/img128.png"
    }
  },

  "icons":{
    "16": "assets/img16.png",
    "48": "assets/img48.png",
    "128": "assets/img128.png"
  }
}