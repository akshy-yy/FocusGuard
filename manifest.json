{
  "manifest_version": 3,
  "name": "FocusGuard",
  "description": "Website blocker for focused work",
  "version": "1.0",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html"
  }
}